# Copy to .env.operator.local (ignored). Operator scripts only; never import in web code.
# Use Settings > API Keys > Secret key. No NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=
# Use the authorized direct/session-pooler connection from Supabase Connect.
# URL-encode special characters in the database password. TLS validation stays enabled.
DATABASE_URL=
# Optional custom path to the server root certificate downloaded from Database Settings.
# By default scripts use .local/phase2/supabase-db-root.crt if present.
# Do not put sslmode/sslrootcert overrides in DATABASE_URL.
SUPABASE_DB_CA_FILE=
