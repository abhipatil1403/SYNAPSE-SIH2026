# Demo is the only enabled repository until the deployed schema is verified.
NEXT_PUBLIC_APP_MODE=demo
# Fill these locally only after verifying the SYNAPSE project in Adi's org.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Phase 1 is a separate read-only preview. Keep off until identity/security prerequisites pass.
SYNAPSE_PHASE1_READ_ENABLED=false
SYNAPSE_APP_ORIGIN=http://localhost:3000
# Comma-separated approved actual Auth UUIDs only. Empty means no preview account is allowed.
SYNAPSE_PREVIEW_AUTH_IDS=
