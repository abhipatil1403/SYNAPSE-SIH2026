# Demo is the only enabled repository until the deployed schema is verified.
NEXT_PUBLIC_APP_MODE=demo
# Fill these locally only after verifying the SYNAPSE project in Adi's org.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Phase 1 is a separate read-only preview. Keep off until identity/security prerequisites pass.
SYNAPSE_PHASE1_READ_ENABLED=false
SYNAPSE_APP_ORIGIN=http://localhost:3000
# Comma-separated approved actual Auth UUIDs only. Empty means no preview account is allowed.
SYNAPSE_PREVIEW_AUTH_IDS=
# Server-only, restricted gateway login; never use the operator DATABASE_URL here.
SYNAPSE_GATEWAY_DATABASE_URL=
SYNAPSE_GATEWAY_CA_FILE=
SYNAPSE_AUTH_RATE_SECRET=
# Public self-registration remains opt-in; approval is always mandatory.
SYNAPSE_SIGNUP_ENABLED=false
# Set only behind an ingress that overwrites X-Forwarded-For.
SYNAPSE_TRUST_PROXY=false
# Worker-only configuration belongs in .env.worker.local, never a web process.
SYNAPSE_SLA_DATABASE_URL=
SYNAPSE_SLA_CA_FILE=
SYNAPSE_SLA_ENABLED=false
# Generated by workbench:setup; isolated loopback PostgreSQL only.
# Keep the generated values in ignored .env.workbench.local, not this template.
SYNAPSE_WORKBENCH_ENABLED=false
SYNAPSE_WORKBENCH_DATABASE_URL=
SYNAPSE_WORKBENCH_ID=
# Worker-only settings: ignored .env.integrations.local. Never load into Next.
SYNAPSE_DEV_EXTERNAL_PROCESSING_APPROVED=false
SYNAPSE_GEMINI_API_KEY=
SYNAPSE_GEMINI_EMBEDDING_MODEL=gemini-embedding-001
SYNAPSE_INDIC_TRANSLATION_URL=http://127.0.0.1:8001
SYNAPSE_TRANSLATION_API_KEY=
# HF_TOKEN belongs only in ignored .env.translation.local for model preparation.
SYNAPSE_CLAMAV_COMMAND=
SYNAPSE_GMAIL_ENABLED=false
SYNAPSE_GMAIL_APPROVED_ADDRESS=
SYNAPSE_GMAIL_CLIENT_ID=
SYNAPSE_GMAIL_CLIENT_SECRET=
# Gmail refresh token is held in the ignored CurrentUser DPAPI vault, not env.
